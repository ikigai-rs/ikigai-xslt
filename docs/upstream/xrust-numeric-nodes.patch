+/// A string as a number, ignoring leading and trailing XML white space; NaN if it is not one.
+pub(crate) fn string_to_double(s: &str) -> f64 {
+    s.trim_matches(|c| matches!(c, ' ' | '\t' | '\r' | '\n'))
+        .parse::<f64>()
+        .unwrap_or(f64::NAN)
+}
