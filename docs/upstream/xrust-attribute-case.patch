--- a/tests/parser.rs
+++ b/tests/parser.rs
@@ -620,3 +620,34 @@
 
     assert!(parseresult.is_ok());
 }
+
+#[test]
+fn prefixed_attribute_values_keep_their_case() {
+    let doc = r#"<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:dc="http://purl.org/dc/elements/1.1/"><rdf:Description rdf:about="https://Example.org/My-Post" dc:title="My Post" xml:id="Post-1" xml:space="Preserve"><rdf:seeAlso rdf:resource="urn:I:One"/></rdf:Description></rdf:RDF>"#;
+
+    let testxml = RNode::new_document();
+    let parseresult = xml::parse(
+        testxml.clone(),
+        doc,
+        Some(|_: &_| {
+            Err(ParseError::MissingNameSpace {
+                prefix: None,
+                nsuri: None,
+                message: Some(String::from("parser test")),
+            })
+        }),
+    );
+    assert!(parseresult.is_ok());
+
+    let out = testxml.to_xml();
+    for value in [
+        "rdf:about='https://Example.org/My-Post'",
+        "dc:title='My Post'",
+        "xml:id='Post-1'",
+        "rdf:resource='urn:I:One'",
+        // xml:space is still compared without regard to case
+        "xml:space='preserve'",
+    ] {
+        assert!(out.contains(value), "{} not in {}", value, out);
+    }
+}
